# Copy to .env.local (local) or set in DigitalOcean App Platform (production). Server-side only.
GEMINI_API_KEY=
# gemini-gemma (default) or openai-compat (Gemma on a DigitalOcean GPU Droplet)
MODEL_PROVIDER=gemini-gemma
GEMMA_MODELS=gemma-4-31b-it,gemma-4-26b-a4b-it
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
RATE_LIMIT_PER_HOUR=20
MAX_LINES=200
MAX_CHARS=8000
